# MongoDB connection string (local or Atlas)
# Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/request-validation-framework
# Atlas (replace user, password, cluster host, and optional appName):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER_HOST/request-validation-framework?appName=MyApp
MONGODB_URI=mongodb://127.0.0.1:27017/request-validation-framework

# Server port
PORT=4000

# Optional: comma-separated origins for CORS (defaults to http://localhost:5173)
# CORS_ORIGIN=http://localhost:5173
